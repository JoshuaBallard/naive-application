# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Use an API key created FOR THIS APPLICATION ONLY. Do not reuse a key that another
# project is running on: separate keys can be revoked independently, and their spend
# shows up separately when something goes wrong.

ANTHROPIC_API_KEY=REPLACE_ME

# Optional. Defaults are in api/app/agent/config.py.
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=medium
# AGENT_QUESTIONS_PER_SESSION=8
